generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma/client"
}

datasource db {
  provider = "sqlite"
  url      = "file:./social-video-manager-db.db"
}

model Video {
  id          Int      @id @default(autoincrement())
  title       String?
  description String?
  created_at  DateTime @default(now())
  reposted    Boolean  @default(false)
  boosted     Boolean  @default(false)

  posts           Post[]
  VideoMetricTask VideoMetricTask[]

  @@map("videos")
}

model VideoMetricTask {
  id         Int      @id @default(autoincrement())
  video_id   Int
  social_id  Int
  postUrl    String
  status     String   @default("PENDENTE")
  views      Int?
  error      String?
  updated_at DateTime @updatedAt
  created_at DateTime @default(now())

  video  Video  @relation(fields: [video_id], references: [id])
  social Social @relation(fields: [social_id], references: [id])

  @@map("video_metric_tasks")
}

model Social {
  id              Int               @id @default(autoincrement())
  name            String            @unique
  url             String?
  icon            String?
  posts           Post[]
  videoMetricTask VideoMetricTask[]

  @@map("socials")
}

model Post {
  id        Int      @id @default(autoincrement())
  video_id  Int
  social_id Int
  link      String
  post_date DateTime

  video  Video  @relation(fields: [video_id], references: [id])
  social Social @relation(fields: [social_id], references: [id])

  @@unique([video_id, social_id])
  @@map("posts")
}

model User {
  id       Int    @id @default(autoincrement())
  name     String
  email    String @unique
  password String

  @@map("users")
}
